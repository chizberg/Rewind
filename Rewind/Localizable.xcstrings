    "eccv16-description" : {
      "comment" : "description of the ECCV16 colorization model in the picker",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleiner und schneller. Die Farben sind weicher und weniger genau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaller and faster. Colors are softer and less accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más pequeño y rápido. Colores más suaves y menos precisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus petit et plus rapide. Couleurs plus douces et moins précises."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кішірек әрі жылдамырақ. Түстері жұмсағырақ, дәлдігі төменірек."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше и быстрее. Цвета мягче и менее точные."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manji i brži. Boje su blaže i manje precizne."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менша і швидша. Кольори м'якші та менш точні."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kichikroq va tezroq. Ranglar yumshoqroq va aniqligi kamroq."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体积更小、速度更快。色彩更柔和，准确度略低。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più piccolo e veloce. I colori sono più tenui e meno accurati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleiner en sneller. De kleuren zijn zachter en minder nauwkeurig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre og hurtigere. Farverne er blødere og mindre præcise."
