    "onboarding_location" : {
      "comment" : "Description of location access in the onboarding",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind benötigt deinen Standort, um Fotos und Gemälde in deiner Nähe anzuzeigen. Ohne diese Berechtigung kannst du die App trotzdem nutzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind needs your location to show photos and paintings near you. Without it you can still use the app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind necesita tu ubicación para mostrar fotos y pinturas cerca de ti. Sin ella aún puedes usar la app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind a besoin de votre position pour afficher les photos et peintures près de vous. Sans cela, vous pouvez quand même utiliser l'app"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind сізге жақын жердегі фотосуреттер мен картиналарды көрсету үшін орналасқан жеріңізді қажет етеді. Онсыз да қолданбаны пайдалана аласыз"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind нужна ваша локация чтобы показывать фотографии и картины рядом. Без этого доступа приложение тоже можно использовать"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind treba vašu lokaciju da bi prikazivao fotografije i slike u vašoj blizini. Bez toga i dalje možete koristiti aplikaciju"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind потребує вашу локацію, щоб показувати фотографії та картини поблизу. Без цього доступу застосунок теж можна використовувати"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind sizga yaqin joylardagi fotosuratlar va rasmlarni koʻrsatish uchun joylashuvingizni bilishi kerak. Busiz ham ilovadan foydalanishingiz mumkin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind需要访问你的位置，以显示附近的照片和画作。即使不允许，也仍然可以使用App"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind ha bisogno della tua posizione per mostrarti foto e dipinti vicino a te. Senza di essa puoi comunque usare l'app"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind heeft je locatie nodig om foto's en schilderijen bij je in de buurt te laten zien. Zonder locatie kun je de app ook gebruiken"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind skal bruge din lokalitet for at vise fotos og malerier i nærheden af dig. Uden den kan du stadig bruge appen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind potrzebuje Twojej lokalizacji, aby pokazywać zdjęcia i obrazy w pobliżu. Bez niej też możesz korzystać z aplikacji"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewind potřebuje vaši polohu, aby vám mohl ukazovat fotografie a obrazy v okolí. I bez ní můžete aplikaci používat"
          }
        }
      }
    },
